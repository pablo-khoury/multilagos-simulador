# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# ==============================================================================
# CONFIGURAÇÃO DO GOOGLE WORKSPACE & FIREBASE (Para Easypanel / Servidor Próprio)
# ==============================================================================
# Se você hospedar no Easypanel, Docker ou VPS, preencha as variáveis abaixo
# com as credenciais do seu projeto gratuito no Firebase Console (console.firebase.google.com):
#
# Dica: Você também pode colar essas credenciais diretamente pelo navegador na aba
# "Google Workspace" -> "Configurar Firebase Próprio" no Painel do Consultor!
#
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_OAUTH_CLIENT_ID=""
